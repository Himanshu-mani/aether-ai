# Local Ollama configuration
OLLAMA_BASE_URL=http://localhost:11434
MODEL_NAME=gemma2:2b
EMBEDDING_MODEL=nomic-embed-text
DEFAULT_NUM_CTX=4096
MAX_WEB_SCRAPE_CONCURRENCY=2
MAX_UPLOAD_MB=20
